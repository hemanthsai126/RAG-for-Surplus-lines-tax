# Copy to .env and adjust. RAG does not fine-tune the LLM; it re-embeds your files and
# retrieves at question time. Pull a small Qwen in Ollama, e.g.:
#   ollama pull qwen2.5:3b-instruct
#   ollama pull qwen2.5:1.5b-instruct

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Default: index webpage_pdfs/ and data/ together when both exist (each recursive).
# Single root: PDFS_DIR=data
# Multiple roots: PDFS_DIRS=data/pdfs,data/california

# Optional: boost chunks whose `source` path contains any substring (comma-separated, case-insensitive)
# RETRIEVAL_PATH_BONUS_SUBSTRINGS=ins_codes
# RETRIEVAL_PATH_RRF_BONUS=0.12

# Set true to block queries that lack insurance keywords (default: off — model answers and relates to insurance)
# STRICT_DOMAIN_GUARD=true

# Default: Risko persona (insurance-only + RAG rules). Set false for legacy system prompt only.
# USE_RISKO=true
